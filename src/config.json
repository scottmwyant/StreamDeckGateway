{
    "streamdeck": {
        "longPress_ms": 1000
    },
    "logging.config": {
        "version": 1,
        "formatters": {
            "simple": {
                "format": "%(asctime)s %(levelname)-8s %(name)-15s %(message)s"
            }
        },
        "handlers": {
            "console": {
                "class": "logging.StreamHandler",
                "formatter": "simple",
                "stream": "ext://sys.stdout"
            }
        },
        "root": {
            "level": "INFO",
            "handlers": ["console"]
        }
    }
}
